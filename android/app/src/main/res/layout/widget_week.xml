<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wb_wk_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Týždeň 23.–29. 11."
                android:textColor="@color/w_fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wb_wk_sum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text="18 h 20"
                android:textColor="@color/w_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wb_wk_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/w_fg"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wb_wk_bars"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Kapacita dní v týždni"
                android:scaleType="fitXY"
                android:src="@drawable/wb_week_preview" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <View
                    android:id="@+id/wb_wk_t1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Pondelok" />

                <View
                    android:id="@+id/wb_wk_t2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Utorok" />

                <View
                    android:id="@+id/wb_wk_t3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Streda" />

                <View
                    android:id="@+id/wb_wk_t4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Štvrtok" />

                <View
                    android:id="@+id/wb_wk_t5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Piatok" />

                <View
                    android:id="@+id/wb_wk_t6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Sobota" />

                <View
                    android:id="@+id/wb_wk_t7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Nedeľa" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
