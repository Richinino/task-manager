<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_weight="1"
        android:background="@drawable/wa_pill_bg"
        android:contentDescription="@string/wa_capture_cd"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/wa_ic_plus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:singleLine="true"
            android:text="@string/wa_pill"
            android:textColor="@color/w_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="6dp"
        android:background="@drawable/wa_circle_chip"
        android:contentDescription="@string/wa_dictate_cd"
        android:padding="13dp"
        android:src="@drawable/wa_ic_mic" />
</LinearLayout>
