# Všetky premenné, ktoré appka číta. Lokálne: skopíruj do .env.local.
# V produkcii (Vercel) sa nastavujú v Settings → Environment Variables —
# postup je v docs/NASADENIE.md (anglicky docs/DEPLOY.md).
#
# Zakomentované riadky sú nepovinné; bez nich appka funguje.

# ─── Databáza ────────────────────────────────────────────────────────────────
# Lokálny vývoj: nechaj prázdne → použije sa vstavaný PGlite v priečinku .data/
# Produkcia (Neon): postgresql://user:heslo@host/db?sslmode=require
# Mimo localhostu sa pripája VŽDY cez TLS s overeným certifikátom.
DATABASE_URL=

# Kam si lokálny PGlite ukladá dáta (predvolene ./.data/db). Zmeň, keď je
# projekt v priečinku, ktorý synchronizuje cloud (OneDrive, Dropbox, iCloud) —
# ten mení súbory pod rukami bežiacej databáze a PGlite potom nenaštartuje.
# PGLITE_DATA_DIR=C:/pgdata/task-manazer

# ─── Auth ────────────────────────────────────────────────────────────────────
# Vygeneruj: npx auth secret
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stabilná verejná adresa appky, bez lomítka na konci. Lokálne netreba.
# Na Verceli ju NEVYNECHAJ: každé nasadenie má aj vlastnú jednorazovú adresu
# a bez AUTH_URL by si z nej appka postavila prihlasovaciu adresu, ktorú Google
# nepozná (Chyba 400: redirect_uri_mismatch).
# AUTH_URL=https://tvoja-adresa.vercel.app

# Kto sa smie prihlásiť. Viac e-mailov oddeľ čiarkou:
#   ALLOWED_EMAILS=ja@gmail.com,otec@gmail.com
# Ak ostane prázdne, v produkcii sa neprihlási NIKTO (lokálne ktokoľvek).
# Starý názov ALLOWED_EMAIL stále funguje ako záloha.
ALLOWED_EMAILS=

# Vývojové prihlásenie bez Googlu. Funguje LEN mimo produkcie.
# Nastav na 1, ak chceš appku spustiť skôr, než vybavíš Google OAuth.
AUTH_DEV_BYPASS=1

# ─── Notifikácie (Web Push) ──────────────────────────────────────────────────
# Vygeneruj RAZ: npx web-push generate-vapid-keys
# Kľúče už nikdy nemeň — po zmene prestanú platiť všetky prihlásenia.
# Kým sú prázdne, appka sa na notifikácie ani neopýta (sekcia sa nevykreslí).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt pre push službu (mailto: alebo https:). Bez neho sa použije AUTH_URL.
VAPID_SUBJECT=

# Tajomstvo, ktorým sa cron hlási na /api/pripomienky aj /api/rozvrh
# (hlavička Authorization: Bearer <tajomstvo>). Vygeneruj napr. npx auth secret.
# Kým je prázdne, obe cesty vracajú 401 KAŽDÉMU — zámerne fail-closed.
# To isté tajomstvo patrí do cron-job.org, prípadne medzi tajomstvá GitHubu
# (CRON_SECRET spolu s PRIPOMIENKY_URL a ROZVRH_URL pre záložné workflowy).
CRON_SECRET=

# ─── Školský rozvrh (EduPage) — nepovinné ────────────────────────────────────
# Adresa Webcal odberu: EduPage → Nastavenia → Ostatné → Môj profil → Webcal.
# Je to tajomstvo — kto ju má, vidí, kde si kedy. Appka ju nikdy nevydá von.
# Adresa so schémou webcal:// je v poriadku, appka si ju prepíše na https://.
# SKOLA_ICS_URL=

# ─── Vlastné .apk (TWA) — nepovinné ──────────────────────────────────────────
# Kým nie sú obe nastavené, /.well-known/assetlinks.json vracia 404 (zámerne).
# ANDROID_PACKAGE_NAME=com.example.ulohy
# Odtlačky SHA-256 podpisového certifikátu, viac oddeľ čiarkou.
# ANDROID_CERT_FINGERPRINTS=

# ─── Migrácie pri builde — len na mimoriadne situácie ───────────────────────
# `npm run build` migruje produkčnú databázu sám, ale LEN pri produkčnom
# nasadení na Verceli (VERCEL_ENV=production — tú nastavuje Vercel, nie ty).
# Pri inom hostingu migráciu vynúť, inak build zastaví brána migrácií:
# MIGROVAT_PRI_BUILDE=1
# Únikové východy, keby sa pokazil samotný krok migrácie alebo jej kontrola:
# SKIP_MIGRATION=1
# SKIP_MIGRATION_CHECK=1
