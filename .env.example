# ─── Databáza ────────────────────────────────────────────────────────────────
# Lokálny vývoj: nechaj prázdne → použije sa vstavaný PGlite v priečinku .data/
# Produkcia (Neon): postgresql://user:heslo@host/db?sslmode=require
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Vygeneruj: npx auth secret
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Iba tento e-mail sa smie prihlásiť (jednopoužívateľský systém).
# Ak ostane prázdne, dnu sa dostane ktokoľvek s Google účtom — v produkcii vyplň!
ALLOWED_EMAIL=

# Vývojové prihlásenie bez Googlu. Funguje LEN mimo produkcie.
# Nastav na 1, ak chceš appku spustiť skôr, než vybavíš Google OAuth.
AUTH_DEV_BYPASS=1
